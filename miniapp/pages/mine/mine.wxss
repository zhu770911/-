.profile-card { text-align: center; padding: 40rpx; }
.avatar { font-size: 80rpx; }
.nickname { font-size: 36rpx; font-weight: bold; margin-top: 16rpx; }
.phone { font-size: 26rpx; color: #999; margin-top: 8rpx; }
.credit { font-size: 28rpx; color: #67C23A; margin-top: 12rpx; }
.logout-btn { margin-top: 40rpx; color: #F56C6C; background: #fff; }
.login-card { padding: 40rpx; }
.login-title { font-size: 36rpx; font-weight: bold; text-align: center; margin-bottom: 40rpx; }
.login-input {
  border: 1rpx solid #e5e5e5; border-radius: 12rpx; padding: 20rpx;
  font-size: 28rpx; margin-bottom: 24rpx;
}
.login-btn { background: #409EFF; color: #fff; margin-top: 20rpx; }
.toggle-text {
  display: block; text-align: center; color: #409EFF; font-size: 26rpx;
  margin-top: 24rpx;
}
